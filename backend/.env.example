# Copy to .env and adjust. Never commit the real .env.

# Flask CLI: lets "flask run", "flask seed" and "flask db ..." find the app
FLASK_APP=run.py
FLASK_DEBUG=1

# Change this before deploying
SECRET_KEY=change-me

# Signs login tokens. REQUIRED in production: use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# How long a sign-in lasts
JWT_EXPIRES_HOURS=12

# Leave empty to use SQLite at instance/ar_vision.db
DATABASE_URL=

# Frontend addresses allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploaded images (room photos, thumbnails, material images)
UPLOAD_FOLDER=uploads
MAX_IMAGE_MB=10
MAX_IMAGE_SIDE=1600

# Create tables and seed sample data automatically when the app starts (1 = yes)
AUTO_SETUP_DB=1
